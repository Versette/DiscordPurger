<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiscordPurger"
        x:Class="DiscordPurger.Views.MainWindow"
        Title="Discord Purger"
        Background="Black" WindowStartupLocation="CenterScreen"
        MinWidth="600" MinHeight="400" Width="1000" Height="700"
        WindowState="Normal" SystemDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="NoChrome">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Background="{DynamicResource DarkBg}" Height="30"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title and Drag Area -->
                <Border Grid.Column="0" Background="Transparent"
                        PointerPressed="TitleBar_PointerPressed">
                    <TextBlock Text="DiscordPurger"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="Bold" FontSize="12"
                               VerticalAlignment="Center"
                               Margin="10,0" />
                </Border>

                <!-- Minimize Button -->
                <Button Grid.Column="1" Content="−"
                        Width="30" Height="30"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextBrush}"
                        FontSize="16" FontWeight="Bold"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="MinimizeButton_Click">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#40FFFFFF" />
                        </Style>
                    </Button.Styles>
                </Button>

                <!-- Close Button -->
                <Button Grid.Column="2" Content="✕"
                        Width="30" Height="30"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextBrush}"
                        FontSize="12" FontWeight="Bold"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="CloseButton_Click">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#FFCC0000" />
                        </Style>
                    </Button.Styles>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content -->
        <local:MainView Grid.Row="1" />
    </Grid>
</Window>