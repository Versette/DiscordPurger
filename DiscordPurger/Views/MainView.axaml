<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiscordPurger.Controls"
             xmlns:viewModels="clr-namespace:DiscordPurger.ViewModels"
             x:Class="DiscordPurger.Views.MainView"
             x:DataType="viewModels:MainViewModel">


    <Grid Margin="8" Background="{DynamicResource DarkBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Warning Header -->
        <Border Grid.Row="0" Classes="DarkPanel" Margin="0,0,0,8"
                BorderBrush="#FF0000" BorderThickness="1"
                Background="#4D0000"
                CornerRadius="3"
                Padding="0">
            <StackPanel Margin="4,1,4,1">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="⚠" FontSize="18" Foreground="White" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,4,0" />

                    <TextBlock
                        Text="WARNING"
                        FontSize="14" Foreground="White" TextWrapping="Wrap"
                        TextAlignment="Center" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock
                    Text="Any tool that automates actions on Discord user accounts can lead to account termination under Discord's self-bot policy."
                    FontSize="14" Foreground="White" TextWrapping="Wrap"
                    TextAlignment="Center" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2" IsEnabled="{Binding IsLoaded}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Channels Panel -->
            <Border Grid.Column="0" Classes="DarkPanel" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="Channels" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="All" Command="{Binding SelectAllCmd}" Classes="DarkButton" MinWidth="40"
                                    Height="28" Margin="0,0,4,0" />
                            <Button Content="None" Command="{Binding SelectNoneCmd}" Classes="DarkButton" MinWidth="48"
                                    Height="28" />
                        </StackPanel>
                    </Grid>

                    <TextBox Grid.Row="1" Text="{Binding SearchText}" Classes="DarkTextBox"
                             Watermark="Search channels..." Margin="0,8,0,8" />

                    <ListBox Grid.Row="2" ItemsSource="{Binding FilteredChannels}" Background="Transparent"
                             BorderThickness="0" Classes="NoOverlayScrollBar">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="3" Padding="5"
                                        Margin="0,0,0,5">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding IsSelected}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextBrush}" />
                                                <TextBlock Text="{Binding Count, StringFormat=' ({0})'}"
                                                           Foreground="{DynamicResource SubtleBrush}" Margin="5,0,0,0" />
                                            </StackPanel>
                                        </CheckBox>
                                        <StackPanel IsVisible="{Binding IsSelected}" Margin="18,5,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Messages:" FontSize="11"
                                                           Foreground="{DynamicResource TextBrush}" Margin="0,0,8,0" />
                                                <Button Content="Select Messages" FontSize="10" Height="24"
                                                        MinWidth="90"
                                                        Command="{Binding ShowModalCommand}"
                                                        Classes="DarkButton" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding SelectedCount, StringFormat='Selected: {0}'}"
                                                       FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Separator Grid.Row="3" Margin="0,8" Background="{DynamicResource AccentBrush}" />
                    <TextBlock Grid.Row="4" Text="{Binding Stats}" FontSize="11"
                               Foreground="{DynamicResource TextBrush}" />
                </Grid>
            </Border>

            <!-- Activity Log Panel -->
            <controls:NotificationPanel Grid.Column="1"
                                        DataContext="{Binding NotificationService}" />
        </Grid>


        <StackPanel Grid.Row="3">
            <!-- Data Package Section -->
            <StackPanel Margin="0,8,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Data Package:" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- Login Button -->
                        <Button Content="Load Package" Command="{Binding LoadCmd}"
                                Classes="DarkButton" MinWidth="100" />

                        <Button Content="Login" Command="{Binding LoginCmd}"
                                IsVisible="{Binding !IsLoggedIn}"
                                Classes="DarkButton" MinWidth="90" Height="32" Margin="0,0,8,0" />

                        <Button Content="Start Purge" Command="{Binding StartCmd}" MinWidth="90"
                                Height="32"
                                Margin="8,0"
                                Background="#330000" Foreground="{DynamicResource TextBrush}"
                                BorderBrush="{DynamicResource DangerBrush}" BorderThickness="2" />

                        <Button Content="Stop" Command="{Binding StopCmd}" IsVisible="{Binding IsPurging}"
                                Classes="DarkButton" MinWidth="75" Height="32" />
                    </StackPanel>
                </Grid>

                <ProgressBar IsVisible="{Binding IsLoading}" Value="{Binding Progress}" Maximum="100" Height="6"
                             Background="#333" Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>

            <!-- Purge Section -->
            <StackPanel Margin="0,8,0,0" IsEnabled="{Binding IsLoaded}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="User:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextBrush}" />

                    <!-- User Info -->
                    <Border Grid.Column="1" IsVisible="{Binding IsLoggedIn}" Classes="DarkPanel" Padding="8"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="14" Background="#666" ClipToBounds="True"
                                    Margin="0,0,8,0">
                                <Image Source="{Binding User.AvatarUrl}" Width="28" Height="28" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding User.DisplayName}" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}" FontSize="12" />
                                <TextBlock Text="{Binding User.Username, StringFormat='@{0}'}" FontSize="10"
                                           Foreground="{DynamicResource SubtleBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel IsVisible="{Binding IsPurging}" Margin="0,8,0,0">
                    <ProgressBar Value="{Binding PurgeProgress}" Maximum="100" Height="22" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Deleted, StringFormat='✓ {0}'}"
                                   Foreground="{DynamicResource SuccessBrush}" Margin="0,0,20,0" />
                        <TextBlock Text="{Binding Failed, StringFormat='✗ {0}'}"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   Margin="0,0,20,0" />
                        <TextBlock Text="{Binding Processed, StringFormat='◦ {0}'}"
                                   Foreground="{DynamicResource InfoBrush}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Login Modal Overlay -->
        <controls:LoginModal Grid.Row="0" Grid.RowSpan="4" DataContext="{Binding LoginViewModel}" />

        <!-- Message Selection Modal Overlay -->
        <ItemsControl Grid.Row="0" Grid.RowSpan="4" ItemsSource="{Binding Channels}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:MessageSelectionModal DataContext="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>