<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DiscordPurger.Models"
             x:Class="DiscordPurger.Controls.NotificationBubble"
             x:DataType="models:NotificationItem"
             IsVisible="{Binding IsVisible}">

    <Border CornerRadius="8" Padding="12,8" Margin="2,1" MaxWidth="600"
            HorizontalAlignment="Left" Background="#2C2C2C">
        <Border.BorderBrush>
            <SolidColorBrush Color="#4A4A4A" />
        </Border.BorderBrush>
        <Border.BorderThickness>1</Border.BorderThickness>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Status Icon -->
            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                    VerticalAlignment="Top" Margin="0,0,8,0">
                <Border.Background>
                    <SolidColorBrush Color="{Binding IconColor}" />
                </Border.Background>
                <TextBlock Text="{Binding Icon}" FontSize="10" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="White" />
            </Border>

            <!-- Message Content -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                           FontSize="12" Foreground="#E0E0E0" />
                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                           FontSize="10" Foreground="#999" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Close Button -->
            <Button Grid.Column="2" Width="18" Height="18" Padding="0"
                    VerticalAlignment="Top" Margin="8,0,0,0"
                    Background="Transparent" BorderThickness="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Command="{Binding CloseCommand}">
                <TextBlock Text="×" FontSize="12" FontWeight="Bold"
                           Foreground="#999" />
            </Button>
        </Grid>
    </Border>
</UserControl>